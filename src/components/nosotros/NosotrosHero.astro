<section class="w-full bg-background pt-8 pb-16 lg:pt-12 lg:pb-20 border-b border-outline">
	<div class="container-page">
		<!-- Editorial Lead -->
		<div class="mb-14 grid grid-cols-1 items-end gap-gutter-desktop lg:grid-cols-12">
			<div class="flex flex-col gap-4 lg:col-span-8">
				<span class="font-caption text-caption font-semibold uppercase tracking-wider text-accent">
					Sobre Montara Inmobiliaria
				</span>
				<h1 class="font-display text-display-mobile md:text-display font-bold leading-tight tracking-tight text-primary max-w-[52rem]">
					Redefiniendo la forma de descubrir, evaluar y adquirir proyectos inmobiliarios.
				</h1>
			</div>
			<div class="flex flex-col justify-end lg:col-span-4">
				<p class="font-body-lg text-body-lg leading-relaxed text-text-muted">
					Montara nació para cerrar la brecha entre desarrollos inmobiliarios de alto valor arquitectónico y compradores e inversores que buscan certeza patrimonial absoluta, digitalización y asesoría sin fricciones.
				</p>
			</div>
		</div>

		<!-- Quick Stats Banner -->
		<div class="grid grid-cols-2 gap-4 rounded-card border border-outline bg-surface-tinted p-6 shadow-level-1 lg:grid-cols-4 lg:p-8">
			<div class="flex flex-col gap-1 p-3 border-r border-outline/60 last:border-0 md:border-r">
				<div class="flex items-baseline gap-1">
					<span class="font-display text-[32px] md:text-display font-bold text-primary">+$18M</span>
					<span class="font-label-md text-label-md font-semibold text-accent">USD</span>
				</div>
				<p class="font-body-sm text-body-sm text-text-muted">En portafolio auditado y gestionado</p>
			</div>

			<div class="flex flex-col gap-1 p-3 border-r border-outline/60 last:border-0 lg:border-r">
				<div class="flex items-baseline gap-1">
					<span class="font-display text-[32px] md:text-display font-bold text-accent">100%</span>
				</div>
				<p class="font-body-sm text-body-sm text-text-muted">Debida diligencia técnica y legal</p>
			</div>

			<div class="flex flex-col gap-1 p-3 border-r border-outline/60 last:border-0 md:border-r">
				<div class="flex items-baseline gap-1">
					<span class="font-display text-[32px] md:text-display font-bold text-primary">8</span>
					<span class="font-label-md text-label-md font-semibold text-primary">Años</span>
				</div>
				<p class="font-body-sm text-body-sm text-text-muted">Estructurando proyectos en el norte</p>
			</div>

			<div class="flex flex-col gap-1 p-3">
				<div class="flex items-baseline gap-1">
					<span class="font-display text-[32px] md:text-display font-bold text-primary">+450</span>
				</div>
				<p class="font-body-sm text-body-sm text-text-muted">Familias e inversores acompañados</p>
			</div>
		</div>
	</div>
</section>
