---
---

<section class="w-full bg-background py-20 lg:py-28">
	<div class="container-page">
		<div class="overflow-hidden rounded-card border border-primary-elevated bg-primary text-white shadow-level-3">
			<div class="grid grid-cols-1 lg:grid-cols-2">
				<!-- Side A: B2C (Compradores / Inversionistas) -->
				<div class="flex flex-col justify-between gap-8 bg-primary p-8 lg:p-14 border-b border-primary-elevated lg:border-b-0 lg:border-r">
					<div class="flex flex-col gap-4">
						<span class="font-caption text-caption font-semibold uppercase tracking-wider text-accent">
							Para Compradores e Inversionistas
						</span>
						<h3 class="font-headline-md text-headline-md font-bold text-white leading-tight">
							¿Buscas un lote o propiedad para construir o rentabilizar?
						</h3>
						<p class="font-body-md text-body-md text-white/85 leading-relaxed">
							Conversa directamente con un asesor inmobiliario de Montara. Te presentaremos opciones filtradas según tu presupuesto y horizonte de plusvalía, sin ningún costo de comisión.
						</p>
					</div>

					<div class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-center">
						<a
							class="inline-flex items-center justify-center gap-2 rounded-pill bg-accent px-6 py-3.5 font-label-md text-label-md font-semibold text-white shadow-md transition-all duration-200 hover:bg-accent-hover"
							href="https://wa.me/51999999999?text=Hola%20Montara,%20deseo%20asesoría%20sobre%20los%20proyectos%20activos"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="material-symbols-outlined text-[20px]">chat</span>
							<span>Conversar por WhatsApp</span>
						</a>
						<a
							class="inline-flex items-center justify-center gap-2 rounded-pill border border-white/20 bg-white/10 px-6 py-3.5 font-label-md text-label-md font-medium text-white transition-all duration-200 hover:bg-white/20"
							href="/proyectos"
						>
							<span>Ver proyectos</span>
							<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
						</a>
					</div>
				</div>

				<!-- Side B: B2B (Promotores y Desarrolladores) -->
				<div class="flex flex-col justify-between gap-8 bg-primary-elevated p-8 text-white lg:p-14">
					<div class="flex flex-col gap-4">
						<span class="font-caption text-caption font-semibold uppercase tracking-wider text-accent">
							Para Desarrolladores & Promotores
						</span>
						<h3 class="font-headline-md text-headline-md font-bold text-white leading-tight">
							¿Desarrollas en el norte y buscas acelerar tu velocidad de venta?
						</h3>
						<p class="font-body-md text-body-md text-white/85 leading-relaxed">
							Integra tu proyecto en nuestro ecosistema. Diseñamos tu showroom digital interactivo y conectamos tu inventario con compradores calificados y nuestra red de inversionistas patrimoniales.
						</p>
					</div>

					<div class="flex flex-col items-stretch gap-4 sm:flex-row sm:items-center">
						<a
							class="inline-flex items-center justify-center gap-2 rounded-pill bg-surface px-6 py-3.5 font-label-md text-label-md font-semibold text-primary transition-all duration-200 hover:bg-surface-tinted"
							href="/para-desarrolladores"
						>
							<span>Ecosistema Desarrolladores</span>
							<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
						</a>
						<a
							class="inline-flex items-center justify-center gap-2 rounded-pill border border-white/20 bg-transparent px-6 py-3.5 font-label-md text-label-md font-medium text-white transition-all duration-200 hover:bg-white/10"
							href="https://wa.me/51999999999?text=Hola%20Montara,%20soy%20desarrollador%20y%20deseo%20una%20reunión%20técnica"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span>Agendar reunión</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
