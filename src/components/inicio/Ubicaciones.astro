---
const locations = [
	{
		id: 'pimentel',
		name: 'Pimentel',
		lat: -6.8367,
		lng: -79.9342,
		activeTag: '3 Proyectos Activos',
		text: 'El balneario residencial por excelencia. Brisa marina, malecón histórico y constante valorización por alta demanda residencial y casas de playa.',
		project: 'Mirador de la Costa',
		status: 'En venta',
	},
	{
		id: 'chiclayo',
		name: 'Chiclayo Urbano',
		lat: -6.7714,
		lng: -79.8409,
		activeTag: '4 Proyectos Activos',
		text: 'Conectividad total, cercanía a centros comerciales, colegios y clínicas de prestigio. Edificios residenciales de alta valorización y confort urbano.',
		project: 'Altos del Bosque · Los Álamos',
		status: 'Departamentos',
	},
	{
		id: 'reque',
		name: 'Reque & Eje Sur',
		lat: -6.8656,
		lng: -79.8178,
		activeTag: '2 Proyectos Activos',
		text: 'Tranquilidad campestre, sol todo el año y microclima cálido. La mejor zona para casas de campo, huertos y quintas familiares con masterplan.',
		project: 'Finca Sevilla (En Comercialización)',
		status: 'Campo',
	},
	{
		id: 'monsefu',
		name: 'Monsefú / Lambayeque',
		lat: -6.8783,
		lng: -79.8697,
		activeTag: '2 Proyectos Activos',
		text: 'Corredores de crecimiento planificado, amplios lotes y proyectos agro-residenciales con titulación verificada y proyección de plusvalía.',
		project: 'Condominio El Roble',
		status: 'Preventa',
	},
];
---

<section class="w-full border-y border-outline bg-surface-tinted py-3xl">
	<div class="container-page">
		<div class="mb-2xl flex flex-col justify-between gap-4 md:flex-row md:items-end">
			<div>
				<h2 class="mt-1 font-headline-lg text-headline-lg text-text">
					Ubicaciones Estratégicas en el Norte
				</h2>
				<p class="mt-2 max-w-[42rem] font-body-md text-body-md text-text-muted">
					Zonas de máxima plusvalía en Chiclayo, Pimentel y corredores en expansión urbana
					auditada.
				</p>
			</div>
		</div>

		<div class="grid grid-cols-1 gap-lg sm:grid-cols-2 lg:grid-cols-4">
			{
				locations.map((loc) => (
					<div class="group flex flex-col justify-between overflow-hidden rounded-card border border-outline bg-surface transition-all duration-300 hover:border-accent hover:shadow-level-2">
						<div class="relative h-44 w-full overflow-hidden bg-slate-100">
							<div
								id={`map-${loc.id}`}
								class="location-map absolute inset-0 z-0 h-full w-full"
								data-lat={loc.lat}
								data-lng={loc.lng}
								data-title={loc.name}
								data-project={loc.project}
							/>
							<div class="pointer-events-none absolute inset-0 z-10 bg-gradient-to-t from-black/40 via-transparent to-black/10" />
							
							<div class="pointer-events-none absolute top-3 left-3 right-3 z-20 flex items-center justify-between">
								<span class="rounded-pill bg-accent/90 px-2 py-0.5 font-caption text-[11px] font-semibold text-white shadow-sm backdrop-blur-sm">
									{loc.activeTag}
								</span>
							</div>

							<div class="pointer-events-none absolute bottom-3 left-3 z-20 flex items-center gap-1.5">
								<span class="relative flex h-3 w-3">
									<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75" />
									<span class="relative inline-flex h-3 w-3 rounded-full border-2 border-white bg-accent" />
								</span>
								<span class="rounded border border-white/20 bg-black/85 px-2 py-0.5 text-[10px] font-semibold text-white backdrop-blur-md">
									{loc.project}
								</span>
							</div>
						</div>

						<div class="flex flex-1 flex-col justify-between p-5">
							<div>
								<h3 class="mb-1 font-title-lg text-title-lg font-bold text-text transition-colors group-hover:text-accent">
									{loc.name}
								</h3>
								<p class="font-body-sm text-body-sm leading-relaxed text-text-muted">{loc.text}</p>

								<div class="mt-3.5 flex items-center justify-between rounded-input border border-outline bg-surface-tinted p-2.5 text-[12px]">
									<div class="flex items-center gap-2 overflow-hidden">
										<span class="material-symbols-outlined shrink-0 text-[16px] text-accent">stars</span>
										<span class="truncate font-medium text-text">{loc.project}</span>
									</div>
									<span class="shrink-0 rounded bg-accent/20 px-1.5 py-0.5 font-caption text-[10px] font-bold uppercase text-accent">
										{loc.status}
									</span>
								</div>
							</div>

							<div class="mt-5 flex items-center justify-between border-t border-outline pt-3 text-[13px] font-semibold text-accent">
								<a
									href="#proyectos-destacados"
									class="flex items-center gap-1 transition-all hover:gap-2 hover:underline"
								>
									<span>Explorar proyectos en {loc.name.split(' ')[0]}</span>
									<span class="material-symbols-outlined text-[16px]">arrow_forward</span>
								</a>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	import L from 'leaflet';

	const initMaps = () => {
		const mapElements = document.querySelectorAll<HTMLElement>('.location-map');

		mapElements.forEach((el) => {
			if (el.dataset.initialized) return;
			el.dataset.initialized = 'true';

			const lat = parseFloat(el.dataset.lat || '0');
			const lng = parseFloat(el.dataset.lng || '0');
			const title = el.dataset.title || '';
			const project = el.dataset.project || '';

			if (!lat || !lng) return;

			const map = L.map(el, {
				center: [lat, lng],
				zoom: 14.5,
				zoomControl: false,
				attributionControl: false,
				dragging: false,
				scrollWheelZoom: false,
				doubleClickZoom: false,
				boxZoom: false,
				keyboard: false,
				touchZoom: false,
			});

			L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
				maxZoom: 19,
				attribution: '&copy; OpenStreetMap',
			}).addTo(map);

			const customIcon = L.divIcon({
				className: 'custom-leaflet-marker',
				html: `
					<div class="relative flex items-center justify-center">
						<span class="absolute inline-flex h-9 w-9 animate-ping rounded-full bg-[#10b981]/50 opacity-75"></span>
						<span class="relative flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-[#059669] shadow-xl">
							<span class="h-2 w-2 rounded-full bg-white"></span>
						</span>
					</div>
				`,
				iconSize: [36, 36],
				iconAnchor: [18, 18],
			});

			const marker = L.marker([lat, lng], { icon: customIcon }).addTo(map);
			marker.bindPopup(`<strong>${title}</strong><br/>${project}`);
		});
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initMaps);
	} else {
		initMaps();
	}
</script>

<style is:global>
	.leaflet-container {
		background-color: #f8fafc !important;
		font-family: inherit;
	}
	.custom-leaflet-marker {
		background: transparent !important;
		border: none !important;
	}
</style>
