---
const metrics = [
	{ value: '+$18M', label: 'USD en portafolio', text: 'Valor auditado en proyectos comercializados' },
	{ value: '100%', label: 'Títulos auditados', text: 'Partidas registrales y licencias vigentes' },
	{ value: '+450', label: 'Familias & Inversores', text: 'Asesorados con éxito sin fricciones' },
	{ value: '+8 Años', label: 'En el mercado norte', text: 'Trayectoria comercial y solvencia técnica' },
];

const partners = [
	{ icon: 'corporate_fare', name: 'Desarrolladora Del Norte' },
	{ icon: 'foundation', name: 'Inversiones Los Andes' },
	{ icon: 'domain', name: 'Grupo Hábitat Perú' },
	{ icon: 'apartment', name: 'Arquitectura Viva' },
	{ icon: 'real_estate_agent', name: 'Costa Norte Capital' },
	{ icon: 'villa', name: 'Urbaniza Lambayeque' },
	{ icon: 'business_center', name: 'Inmobiliaria Pacífico Norte' },
	{ icon: 'location_city', name: 'Cumbres del Sol' },
];
---

<section class="w-full border-b border-outline bg-surface py-3xl">
	<div class="container-page">
		<div class="mb-14 rounded-card border border-outline bg-surface-tinted p-8 md:p-12">
			<div class="mb-10 flex flex-col justify-between gap-8 border-b border-outline pb-8 lg:flex-row lg:items-center">
				<div class="max-w-[36rem]">
					<h2 class="font-headline-md text-headline-md font-bold text-primary">
						Auditoría Legal y Técnica Montara
					</h2>
					<p class="mt-2 font-body-md text-body-md text-text-muted">
						No publicamos proyectos sin verificación exhaustiva de partidas registrales, licencias
						de habilitación urbana y antecedentes del promotor.
					</p>
				</div>
				<div class="flex items-center gap-4 rounded-card border border-accent/30 bg-surface px-5 py-4 shadow-level-1">
					<span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
						<span class="material-symbols-outlined text-[28px]">gavel</span>
					</span>
					<div>
						<span class="block text-sm font-bold text-text">100% Verificación Legal</span>
						<span class="text-xs text-text-muted">Títulos limpios y factibilidad en Sunarp</span>
					</div>
				</div>
			</div>

			<div class="grid grid-cols-2 gap-lg text-center md:grid-cols-4 md:text-left">
				{
					metrics.map((metric, i) => (
						<div class={i < metrics.length - 1 ? 'border-r border-outline pr-4 last:border-0' : 'pr-4'}>
							<span class="block font-display text-[36px] font-bold tracking-tight text-primary md:text-[44px]">
								{metric.value}
							</span>
							<span class="mt-1 block text-xs font-semibold uppercase tracking-wider text-accent">
								{metric.label}
							</span>
							<p class="mt-1 text-xs text-text-muted">{metric.text}</p>
						</div>
					))
				}
			</div>
		</div>

		<div class="text-center overflow-hidden">
			<p class="mb-8 font-caption text-xs font-semibold uppercase tracking-wider text-text-muted md:text-sm">
				Desarrolladores y promotores inmobiliarios aliados que confían en Montara
			</p>
			
			<!-- Infinite Marquee Carousel with Fade Edge Masks -->
			<div class="relative w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
				<div class="logo-marquee flex w-max items-center gap-14 py-4 md:gap-20">
					{
						[...partners, ...partners].map((partner) => (
							<div class="group flex shrink-0 items-center gap-3.5 transition-all duration-200 cursor-default opacity-85 hover:opacity-100">
								<span class="material-symbols-outlined text-[32px] md:text-[38px] text-accent/80 transition-all duration-300 group-hover:scale-110 group-hover:text-accent">
									{partner.icon}
								</span>
								<span class="font-display text-lg md:text-xl lg:text-[22px] font-bold tracking-tight text-primary transition-colors group-hover:text-accent whitespace-nowrap">
									{partner.name}
								</span>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	@keyframes marquee {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-50%);
		}
	}

	.logo-marquee {
		animation: marquee 36s linear infinite;
		will-change: transform;
	}

	.logo-marquee:hover {
		animation-play-state: paused;
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-marquee {
			animation: none;
			flex-wrap: wrap;
			justify-content: center;
			width: 100%;
		}
	}
</style>
