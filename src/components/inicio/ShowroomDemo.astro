---
const lots = [
	{ id: 'B-10', meta: 'Vendido', state: 'sold' },
	{ id: 'B-11', meta: '500 m²', state: 'available' },
	{ id: 'B-12', meta: 'En eval.', state: 'pending' },
	{ id: 'B-13', meta: '510 m²', state: 'available' },
	{ id: 'B-14', meta: '520 m² • Sel.', state: 'selected' },
	{ id: 'B-15', meta: '500 m²', state: 'available' },
	{ id: 'B-16', meta: 'Vendido', state: 'sold' },
	{ id: 'B-17', meta: '530 m²', state: 'available' },
];

const lotStyles: Record<string, string> = {
	sold: 'bg-gray-700/50 border border-gray-600/40 text-gray-400',
	available: 'bg-emerald-600/40 border border-emerald-400/60 text-emerald-200',
	pending: 'bg-amber-500/30 border border-amber-400/50 text-amber-200',
	selected: 'scale-105 rounded-lg bg-accent border-2 border-white text-white shadow-lg font-bold',
};

const steps = [
	{
		n: 1,
		title: 'Explora el croquis lote por lote',
		text: 'Conoce dimensiones exactas, linderos y orientación solar para elegir la mejor ubicación sin salir de casa.',
	},
	{
		n: 2,
		title: 'Transparencia en disponibilidad',
		text: 'Unidades libres y separadas sincronizadas en tiempo real con la mesa de ventas de cada promotor.',
	},
	{
		n: 3,
		title: 'Dossier técnico y partidas auditadas',
		text: 'Acceso inmediato a planos visados, partidas electrónicas de Sunarp y simulador de financiamiento.',
	},
];
---

<section class="relative w-full overflow-hidden bg-primary py-3xl text-white" id="showroom-demo">
	<div class="pointer-events-none absolute -right-20 -top-20 h-96 w-96 rounded-full bg-accent/15 blur-[120px]"></div>
	<div class="pointer-events-none absolute -left-20 -bottom-20 h-80 w-80 rounded-full bg-emerald-400/10 blur-[100px]"></div>

	<div class="container-page relative z-10">
		<div class="mb-2xl max-w-[48rem]">
			<h2 class="font-headline-lg text-headline-lg text-white">
				Así experimentas un proyecto en Montara: Nuestra Vitrina Digital por dentro
			</h2>
			<p class="mt-3 font-body-lg text-body-lg leading-relaxed text-white/80">
				Reemplazamos planos estáticos en PDF por interactividad real antes de visitar la obra.
				Explora lotes, orientación solar y cotiza cuotas en tiempo real.
			</p>
		</div>

		<div class="grid grid-cols-1 items-center gap-2xl lg:grid-cols-12">
			<div class="rounded-card border border-white/15 bg-[#041411] p-4 shadow-level-3 md:p-6 lg:col-span-8">
				<div class="mb-4 flex items-center justify-between border-b border-white/10 pb-4 text-xs text-white/60">
					<div class="flex items-center gap-2">
						<span class="h-3 w-3 rounded-full bg-red-500/80"></span>
						<span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
						<span class="h-3 w-3 rounded-full bg-green-500/80"></span>
						<span class="ml-2 font-mono text-[11px] text-white/80">montara.pe/proyecto/finca-sevilla</span>
					</div>
					<div class="hidden items-center gap-3 sm:flex">
						<span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-emerald-400"></span> 24 Disponibles</span>
						<span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-amber-400"></span> 5 En consulta</span>
						<span class="flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-gray-500"></span> 18 Separados</span>
					</div>
				</div>

				<div class="grid grid-cols-1 gap-4 md:grid-cols-12">
					<div class="flex min-h-[300px] flex-col justify-between rounded-2xl border border-white/10 bg-[#0b2420] p-4 md:col-span-7">
						<div class="mb-2 flex items-center justify-between text-xs text-white/70">
							<span class="font-semibold text-white">Masterplan Etapa 1 • Manzana B</span>
							<div class="flex items-center gap-1 rounded bg-black/40 px-2 py-1">
								<span class="material-symbols-outlined text-[14px] text-emerald-400">north</span>
								<span>Norte Solar</span>
							</div>
						</div>
						<div class="my-auto grid grid-cols-4 gap-2">
							{
								lots.map((lot) => (
									<div class={`rounded p-2 text-center text-[11px] transition-transform ${lotStyles[lot.state]}`}>
										{lot.state === 'selected' && '★ '}
										{lot.id}
										<br />
										<span class="text-[9px] font-normal">{lot.meta}</span>
									</div>
								))
							}
						</div>
						<div class="flex items-center justify-between border-t border-white/10 pt-2 text-[11px] text-white/60">
							<span class="flex items-center gap-1">
								<span class="material-symbols-outlined text-[13px]">touch_app</span> Clic en un lote para ver ficha
							</span>
							<span class="text-emerald-400">Paseo de las Buganvilias</span>
						</div>
					</div>

					<div class="flex flex-col justify-between rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur-md md:col-span-5">
						<div>
							<div class="mb-2 flex items-center justify-between">
								<span class="rounded bg-emerald-500/20 px-2 py-0.5 font-caption text-[11px] font-semibold text-emerald-300">
									DISPONIBLE
								</span>
								<span class="text-xs text-white/60">Finca Sevilla</span>
							</div>
							<h4 class="font-title-lg text-title-lg font-bold text-white">Lote B-14</h4>
							<p class="mt-0.5 text-xs text-white/70">Vista directa a parque central • Orientación Este</p>

							<div class="my-3 grid grid-cols-2 gap-2 rounded-xl border border-white/10 bg-black/30 p-2.5">
								<div>
									<span class="block text-[10px] uppercase text-white/50">Área Total</span>
									<span class="text-sm font-bold text-white">520.00 m²</span>
								</div>
								<div>
									<span class="block text-[10px] uppercase text-white/50">Frente / Fondo</span>
									<span class="text-sm font-bold text-white">16m x 32.5m</span>
								</div>
								<div>
									<span class="block text-[10px] uppercase text-white/50">Precio Lista</span>
									<span class="text-sm font-bold text-emerald-400">$39,800 USD</span>
								</div>
								<div>
									<span class="block text-[10px] uppercase text-white/50">Cuota Ref.</span>
									<span class="text-sm font-bold text-white">$450 / mes</span>
								</div>
							</div>

							<div class="space-y-1.5 text-[11px] text-white/80">
								<div class="flex items-center gap-1.5">
									<span class="material-symbols-outlined text-[14px] text-accent">check_circle</span> Partida registral independizada
								</div>
								<div class="flex items-center gap-1.5">
									<span class="material-symbols-outlined text-[14px] text-accent">check_circle</span> Factibilidad de agua y luz al pie
								</div>
							</div>
						</div>

						<div class="mt-4 flex items-center gap-2 border-t border-white/10 pt-3">
							<button
								type="button"
								class="flex flex-1 items-center justify-center gap-1 rounded-input bg-accent py-2 text-xs font-semibold text-white transition-colors hover:bg-accent-hover"
							>
								<span class="material-symbols-outlined text-[14px]">calendar_month</span> Agendar Visita
							</button>
							<button
								type="button"
								title="Descargar Dossier"
								class="rounded-input bg-white/10 p-2 text-white transition-colors hover:bg-white/20"
							>
								<span class="material-symbols-outlined text-[16px]">file_download</span>
							</button>
						</div>
					</div>
				</div>
			</div>

			<div class="flex flex-col gap-5 lg:col-span-4">
				{
					steps.map((step) => (
						<div class="rounded-card border border-white/10 bg-white/5 p-5">
							<div class="mb-3 flex h-10 w-10 items-center justify-center rounded-input bg-accent/20 font-bold text-accent">
								{step.n}
							</div>
							<h3 class="font-title-md text-title-md font-semibold text-white">{step.title}</h3>
							<p class="mt-1 font-body-sm text-body-sm text-white/70">{step.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
