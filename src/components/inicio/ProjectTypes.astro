<section class="w-full bg-background py-3xl" id="categorias">
	<div class="container-page">
		<div class="mb-2xl flex flex-col justify-between gap-4 md:flex-row md:items-end">
			<div>
				<h2 class="mt-1 font-headline-lg text-headline-lg text-text">
					Explora según tu necesidad patrimonial
				</h2>
				<p class="mt-2 max-w-[36rem] font-body-md text-body-md text-text-muted">
					Encuentra el activo inmobiliario ideal sin necesidad de filtros complejos.
				</p>
			</div>
			<a
				href="#proyectos-destacados"
				class="inline-flex items-center gap-2 font-label-md text-label-md font-semibold text-accent hover:underline"
			>
				Ver catálogo general <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
			</a>
		</div>

		<div class="grid grid-cols-1 gap-lg sm:grid-cols-2 lg:grid-cols-4">
			{
				categories.map((cat) => (
					<div class="group relative flex min-h-[340px] flex-col justify-between overflow-hidden rounded-card bg-primary shadow-level-1 transition-all duration-300 hover:shadow-level-3">
						<img
							src={cat.image}
							alt={cat.title}
							class="absolute inset-0 h-full w-full object-cover opacity-70 transition-transform duration-500 group-hover:scale-105"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent" />
						<div class="relative z-10 flex items-start justify-between p-5">
							<span class="rounded-input bg-white/20 px-2.5 py-1 font-caption text-caption font-medium text-white backdrop-blur-md">
								{cat.tag}
							</span>
							<div class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white transition-colors group-hover:bg-accent">
								<span class="material-symbols-outlined text-[18px]">north_east</span>
							</div>
						</div>
						<div class="relative z-10 p-5">
							<h3 class="mb-1 font-title-lg text-title-lg font-bold text-white">{cat.title}</h3>
							<p class="font-body-sm text-body-sm text-white/80">{cat.text}</p>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
