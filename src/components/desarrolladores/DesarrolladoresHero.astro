---

---

<section
	class="relative w-full overflow-hidden bg-background pt-24 pb-16 md:pt-28 md:pb-24 border-b border-outline"
>
	<!-- Ambient organic gradient blurs -->
	<div
		class="pointer-events-none absolute -left-32 -top-32 h-96 w-96 rounded-full bg-accent/15 blur-3xl"
	>
	</div>
	<div
		class="pointer-events-none absolute -right-32 top-1/2 h-[32rem] w-[32rem] rounded-full bg-primary/10 blur-3xl"
	>
	</div>

	<div class="container-page relative z-10">
		<div
			class="mx-auto flex max-w-[52rem] flex-col items-center text-center"
		>
			<!-- Headline -->
			<h1
				class="font-display text-display-mobile md:text-display font-bold tracking-tight text-primary"
			>
				Tu proyecto merece una exhibición comercial a la altura de su
				valor.
			</h1>

			<!-- Subtitle -->
			<p
				class="mt-4 max-w-[42rem] font-body-lg text-body-lg leading-relaxed text-text-muted"
			>
				Transformamos proyectos inmobiliarios en showrooms digitales
				interactivos y conectamos tu desarrollo con compradores e
				inversionistas calificados.
			</p>

			<!-- Hero CTAs -->
			<div
				class="mt-6 flex w-full flex-col items-center justify-center gap-4 sm:w-auto sm:flex-row"
			>
				<a
					class="inline-flex w-full items-center justify-center gap-2 rounded-pill bg-accent px-8 py-3.5 font-label-md text-label-md font-semibold text-white shadow-level-1 transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent-hover hover:shadow-cta-hover sm:w-auto"
					href="#contacto-b2b"
				>
					<span>Presentar mi proyecto a Montara</span>
					<span class="material-symbols-outlined text-[18px]"
						>arrow_forward</span
					>
				</a>
				<a
					class="inline-flex w-full items-center justify-center gap-2 rounded-pill border border-outline bg-surface px-6 py-3.5 font-label-md text-label-md font-semibold text-text shadow-sm transition-colors hover:bg-surface-tinted sm:w-auto"
					href="#casos-estudio"
				>
					<span
						class="material-symbols-outlined text-[20px] text-accent"
						>layers</span
					>
					<span>Ver showroom de ejemplo (Finca Sevilla)</span>
				</a>
			</div>
		</div>

		<!-- Split Screen Interactive Comparison Component -->
		<div class="mt-14 w-full md:mt-20">
			<div class="mb-6 text-center">
				<span
					class="font-caption text-caption font-semibold uppercase tracking-wider text-text-muted"
				>
					Diferencial de conversión y percepción de marca
				</span>
			</div>

			<div class="grid grid-cols-1 items-stretch gap-8 lg:grid-cols-12">
				<!-- Columna Izquierda: La Forma Tradicional -->
				<div
					class="flex flex-col justify-between overflow-hidden rounded-card border border-outline bg-surface-tinted p-6 shadow-level-1 lg:col-span-5 md:p-8"
				>
					<div>
						<div
							class="flex items-center justify-between pb-4 border-b border-outline/60"
						>
							<span
								class="inline-flex items-center gap-1.5 rounded-pill bg-error-container px-3 py-1 font-caption text-caption font-semibold text-on-error-container"
							>
								<span
									class="material-symbols-outlined text-[16px]"
									>close</span
								>
								La forma tradicional
							</span>
							<span
								class="font-caption text-caption text-text-muted"
								>Post estático & WhatsApp</span
							>
						</div>

						<div
							class="mt-6 space-y-3 rounded-xl bg-surface/80 p-4 shadow-sm"
						>
							<!-- Flyer simulación -->
							<div
								class="relative flex h-36 flex-col justify-end overflow-hidden rounded-lg bg-primary/20 p-3"
							>
								<div class="absolute inset-0 bg-primary/60">
								</div>
								<div class="relative z-10 text-white">
									<span
										class="rounded bg-error px-1.5 py-0.5 font-caption text-[10px] font-bold text-white uppercase"
									>
										¡OFERTA LOTE 120M²!
									</span>
									<p
										class="mt-1 font-title-md text-title-md font-bold leading-tight"
									>
										ÚLTIMOS LOTES EN PREVENTA
									</p>
									<p
										class="font-caption text-caption opacity-80"
									>
										Escribe al DM para más información
									</p>
								</div>
							</div>

							<!-- Leads descalificados list -->
							<div class="space-y-2">
								<div
									class="flex items-center justify-between rounded-lg bg-surface-tinted p-2.5"
								>
									<div class="flex items-center gap-2">
										<span
											class="material-symbols-outlined text-[18px] text-text-muted"
											>chat_bubble</span
										>
										<span
											class="font-body-sm text-body-sm text-text"
											>"Precio inbox por favor"</span
										>
									</div>
									<span
										class="font-caption text-[11px] font-semibold text-error"
										>Lead frío</span
									>
								</div>
								<div
									class="flex items-center justify-between rounded-lg bg-surface-tinted p-2.5"
								>
									<div class="flex items-center gap-2">
										<span
											class="material-symbols-outlined text-[18px] text-text-muted"
											>chat_bubble</span
										>
										<span
											class="font-body-sm text-body-sm text-text"
											>"¿Dónde queda? ¿Se puede a 10 años
											sin inicial?"</span
										>
									</div>
									<span
										class="font-caption text-[11px] font-semibold text-error"
										>Sin calificar</span
									>
								</div>
							</div>
						</div>
					</div>

					<div
						class="mt-6 rounded-xl border border-error/20 bg-error-container/40 p-3"
					>
						<p
							class="flex items-start gap-2 font-body-sm text-body-sm text-on-error-container"
						>
							<span
								class="material-symbols-outlined text-[18px] shrink-0 mt-0.5 text-error"
								>sentiment_dissatisfied</span
							>
							<span
								>Fricción comercial: decenas de horas filtrando
								personas sin solvencia ni horizonte de
								inversión.</span
							>
						</p>
					</div>
				</div>

				<!-- Columna Derecha: La Experiencia Montara -->
				<div
					class="relative flex flex-col justify-between overflow-hidden rounded-card border border-white/10 bg-gradient-to-br from-primary via-primary-elevated to-[#051815] p-6 text-white shadow-level-3 lg:col-span-7 md:p-8"
				>
					<div
						class="pointer-events-none absolute -right-16 -top-16 h-80 w-80 rounded-full bg-accent/20 blur-3xl"
					>
					</div>

					<div class="relative z-10">
						<div
							class="flex flex-wrap items-center justify-between gap-2 pb-4 border-b border-white/10"
						>
							<span
								class="inline-flex items-center gap-1.5 rounded-pill bg-accent/20 border border-accent/40 px-3 py-1 font-caption text-caption font-semibold text-accent"
							>
								<span
									class="material-symbols-outlined text-[16px]"
									>verified</span
								>
								La experiencia Montara
							</span>
							<span
								class="font-caption text-caption text-white/70"
								>Showroom Digital Transaccional</span
							>
						</div>

						<!-- Interactive Mockup Canvas -->
						<div
							class="mt-6 space-y-4 rounded-2xl border border-white/10 bg-black/40 p-4"
						>
							<div class="grid grid-cols-1 gap-3 md:grid-cols-3">
								<div
									class="relative h-48 overflow-hidden rounded-xl bg-primary md:col-span-2"
								>
									<img
										src="https://lh3.googleusercontent.com/aida-public/AB6AXuB4CiXrwR7qTUYPSOmKkmALqyQefDc2nZ6pvuIx9vrZ0f7lf35E9tAftu_bY8Pu98UuNzLuWJljWq1Zn9FgUK9IvGKTksrvVcFzf83glEM_cp5AeJqr0holIfpVNAC1_kLGU9k-XveraiCVoAycNVFawEO0Ty2MCoczADbl_MlIQ9bsyfjmSRQdya7Tm0dY5bMMejUs7la5cbUPOz3LnU3lpSr4mtGKIoQB482DmkkgeRfWjhDyHYLBgQ"
										alt="Masterplan Finca Sevilla"
										class="h-full w-full object-cover"
										loading="lazy"
									/>
									<div
										class="absolute inset-0 bg-gradient-to-t from-primary/90 via-transparent to-transparent"
									>
									</div>
									<div
										class="absolute bottom-2 left-2 right-2 flex items-center justify-between"
									>
										<div
											class="flex items-center gap-1.5 rounded-full bg-white/95 px-2.5 py-1 font-caption text-[11px] font-semibold text-primary backdrop-blur-md"
										>
											<span
												class="h-2 w-2 rounded-full bg-accent"
											></span>
											Lote #42 disponible: 512 m²
										</div>
										<span
											class="rounded bg-primary/80 px-2 py-0.5 font-caption text-[10px] text-white/90 backdrop-blur-sm"
										>
											Filtro Norte Solar
										</span>
									</div>
								</div>

								<!-- Qualified prospect box -->
								<div
									class="flex flex-col justify-between rounded-xl bg-surface p-3 text-text shadow-sm"
								>
									<div>
										<span
											class="block font-caption text-[10px] font-bold uppercase tracking-wider text-accent"
										>
											Lead Calificado Montara
										</span>
										<p
											class="mt-0.5 font-title-md text-title-md font-bold text-primary"
										>
											Carlos M. - Inversionista
										</p>
										<div
											class="mt-2 space-y-1 font-body-sm text-[11px] text-text-muted"
										>
											<p class="flex items-center gap-1">
												<span
													class="material-symbols-outlined text-[14px] text-accent"
													>payments</span
												>
												$65,000 - $80,000
											</p>
											<p class="flex items-center gap-1">
												<span
													class="material-symbols-outlined text-[14px] text-accent"
													>schedule</span
												>
												Plazo: &lt; 30 días
											</p>
											<p class="flex items-center gap-1">
												<span
													class="material-symbols-outlined text-[14px] text-accent"
													>verified_user</span
												>
												Separación lista
											</p>
										</div>
									</div>
									<div
										class="mt-2 flex items-center justify-between rounded-lg bg-surface-tinted p-1.5"
									>
										<span
											class="font-caption text-[10px] text-text-muted"
											>Score comercial:</span
										>
										<span
											class="font-title-md text-title-md font-bold text-accent"
											>96 / 100</span
										>
									</div>
								</div>
							</div>

							<!-- Live Metrics Pills -->
							<div
								class="grid grid-cols-3 gap-2 pt-1 text-center"
							>
								<div
									class="rounded-xl border border-white/10 bg-white/5 p-2"
								>
									<span
										class="block font-caption text-[10px] text-white/60"
										>Tiempo en vista</span
									>
									<span
										class="font-title-md text-title-md font-bold text-accent"
										>4m 18s</span
									>
								</div>
								<div
									class="rounded-xl border border-white/10 bg-white/5 p-2"
								>
									<span
										class="block font-caption text-[10px] text-white/60"
										>Conversión</span
									>
									<span
										class="font-title-md text-title-md font-bold text-accent"
										>14.8%</span
									>
								</div>
								<div
									class="rounded-xl border border-white/10 bg-white/5 p-2"
								>
									<span
										class="block font-caption text-[10px] text-white/60"
										>Validación</span
									>
									<span
										class="font-title-md text-title-md font-bold text-accent"
										>100% verif.</span
									>
								</div>
							</div>
						</div>
					</div>

					<div
						class="relative z-10 mt-6 border-t border-white/10 pt-4"
					>
						<p
							class="flex items-center gap-2 font-body-sm text-body-sm text-white/85"
						>
							<span
								class="material-symbols-outlined text-[20px] text-accent shrink-0"
								>check_circle</span
							>
							<span
								>Tu equipo comercial recibe prospectos educados,
								con plano interactivo estudiado y presupuesto
								alineado.</span
							>
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
