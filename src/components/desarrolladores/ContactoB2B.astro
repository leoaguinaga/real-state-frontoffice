---
---

<section class="w-full bg-background py-16 md:py-24 border-b border-outline" id="contacto-b2b">
	<div class="container-page">
		<div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12">
			<!-- Columna Izquierda: Información de Contacto B2B & Garantías -->
			<div class="space-y-8 lg:col-span-5">
				<div>
					<span class="mb-2 inline-block font-caption text-caption font-semibold uppercase tracking-wider text-accent">
						Alianzas Estratégicas
					</span>
					<h2 class="font-headline-lg text-headline-lg font-bold tracking-tight text-primary">
						Conversemos sobre la comercialización de tu proyecto
					</h2>
					<p class="mt-3 font-body-lg text-body-lg text-text-muted leading-relaxed">
						Déjanos los detalles de tu desarrollo inmobiliario para coordinar una reunión de evaluación sin costo con nuestro equipo directivo.
					</p>
				</div>

				<div class="space-y-4">
					<div class="flex items-start gap-4 rounded-xl border border-outline bg-surface p-4 shadow-sm">
						<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-surface-tinted text-accent">
							<span class="material-symbols-outlined text-[22px]">speed</span>
						</div>
						<div>
							<h3 class="font-title-md text-title-md font-bold text-primary">Respuesta en menos de 24 horas</h3>
							<p class="mt-0.5 font-body-sm text-body-sm text-text-muted">
								Un director comercial asignado evaluará la factibilidad y coordinará la sesión inicial.
							</p>
						</div>
					</div>

					<div class="flex items-start gap-4 rounded-xl border border-outline bg-surface p-4 shadow-sm">
						<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-surface-tinted text-accent">
							<span class="material-symbols-outlined text-[22px]">lock</span>
						</div>
						<div>
							<h3 class="font-title-md text-title-md font-bold text-primary">Acuerdo de Confidencialidad (NDA)</h3>
							<p class="mt-0.5 font-body-sm text-body-sm text-text-muted">
								Tu información técnica, comercial y de proyección territorial se trata con estricta reserva profesional.
							</p>
						</div>
					</div>

					<div class="flex items-start gap-4 rounded-xl border border-outline bg-surface p-4 shadow-sm">
						<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-surface-tinted text-accent">
							<span class="material-symbols-outlined text-[22px]">contact_phone</span>
						</div>
						<div>
							<h3 class="font-title-md text-title-md font-bold text-primary">Canal B2B Institucional Directo</h3>
							<p class="mt-0.5 font-body-sm text-body-sm text-text-muted">
								contacto@montara.pe · (+51) 987 654 321
							</p>
						</div>
					</div>
				</div>
			</div>

			<!-- Columna Derecha: Formulario Profesional B2B -->
			<div class="rounded-card border border-outline bg-surface p-6 shadow-level-2 md:p-10 lg:col-span-7">
				<form class="space-y-8" id="dev-contact-form">
					<!-- Sección 1: Datos de la Empresa y Contacto -->
					<div class="space-y-4">
						<div class="flex items-center gap-2.5 border-b border-outline pb-3">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 font-label-sm text-label-sm font-bold text-accent">
								01
							</span>
							<h3 class="font-title-md text-title-md font-bold text-primary">Datos de la Empresa y Contacto</h3>
						</div>

						<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
							<div>
								<label class="mb-1.5 block font-label-md text-label-md font-semibold text-text" for="company-name">
									Nombre de la empresa promotora <span class="text-accent">*</span>
								</label>
								<input
									class="w-full rounded-input border border-outline bg-surface-tinted px-4 py-3 font-body-md text-body-md text-text transition-all focus:border-accent focus:bg-surface focus:outline-none"
									id="company-name"
									placeholder="Ej. Grupo Inmobiliario Los Andes"
									required
									type="text"
								/>
							</div>

							<div>
								<label class="mb-1.5 block font-label-md text-label-md font-semibold text-text" for="contact-name">
									Nombre completo del contacto <span class="text-accent">*</span>
								</label>
								<input
									class="w-full rounded-input border border-outline bg-surface-tinted px-4 py-3 font-body-md text-body-md text-text transition-all focus:border-accent focus:bg-surface focus:outline-none"
									id="contact-name"
									placeholder="Ej. Alejandro Mendoza"
									required
									type="text"
								/>
							</div>

							<div>
								<label class="mb-1.5 block font-label-md text-label-md font-semibold text-text" for="contact-role">
									Cargo o rol directivo <span class="text-accent">*</span>
								</label>
								<div class="relative">
									<select
										class="w-full cursor-pointer appearance-none rounded-input border border-outline bg-surface-tinted px-4 py-3 pr-10 font-body-md text-body-md text-text transition-all focus:border-accent focus:bg-surface focus:outline-none"
										id="contact-role"
										required
									>
										<option disabled selected value="">Selecciona tu cargo</option>
										<option value="gerente-comercial">Gerente Comercial</option>
										<option value="propietario-terreno">Propietario de Terreno</option>
										<option value="promotor-general">Promotor / Desarrollador General</option>
										<option value="director-inversiones">Director de Inversiones</option>
										<option value="otro">Otro</option>
									</select>
									<span class="material-symbols-outlined pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-[20px] text-text-muted">
										expand_more
									</span>
								</div>
							</div>

							<div>
								<label class="mb-1.5 block font-label-md text-label-md font-semibold text-text" for="corporate-email">
									Correo electrónico corporativo <span class="text-accent">*</span>
								</label>
								<input
									class="w-full rounded-input border border-outline bg-surface-tinted px-4 py-3 font-body-md text-body-md text-text transition-all focus:border-accent focus:bg-surface focus:outline-none"
									id="corporate-email"
									placeholder="nombre@tuempresa.pe"
									required
									type="email"
								/>
							</div>
						</div>
					</div>

					<!-- Sección 2: Información del Proyecto -->
					<div class="space-y-4 pt-2">
						<div class="flex items-center gap-2.5 border-b border-outline pb-3">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 font-label-sm text-label-sm font-bold text-accent">
								02
							</span>
							<h3 class="font-title-md text-title-md font-bold text-primary">Información del Proyecto</h3>
						</div>

						<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
							<div>
								<label class="mb-1.5 block font-label-md text-label-md font-semibold text-text" for="project-type">
									Tipo de proyecto a comercializar <span class="text-accent">*</span>
								</label>
								<div class="relative">
									<select
										class="w-full cursor-pointer appearance-none rounded-input border border-outline bg-surface-tinted px-4 py-3 pr-10 font-body-md text-body-md text-text transition-all focus:border-accent focus:bg-surface focus:outline-none"
										id="project-type"
										required
									>
										<option disabled selected value="">Selecciona tipología</option>
										<option value="lotes-campo">Loteo Campestre / Vacacional</option>
										<option value="departamentos">Edificio de Departamentos</option>
										<option value="casas-condominio">Condominio de Casas</option>
										<option value="mixto">Desarrollo Mixto / Comercial</option>
										<option value="macrolote">Macrolote / Suelo Bruto</option>
									</select>
									<span class="material-symbols-outlined pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-[20px] text-text-muted">
										expand_more
									</span>
								</div>
							</div>

							<div>
								<label class="mb-1.5 block font-label-md text-label-md font-semibold text-text" for="units-count">
									N° estimado de unidades / lotes
								</label>
								<input
									class="w-full rounded-input border border-outline bg-surface-tinted px-4 py-3 font-body-md text-body-md text-text transition-all focus:border-accent focus:bg-surface focus:outline-none"
									id="units-count"
									placeholder="Ej. 65 lotes / 24 departamentos"
									type="text"
								/>
							</div>

							<div class="md:col-span-2">
								<label class="mb-1.5 block font-label-md text-label-md font-semibold text-text" for="project-location">
									Ubicación del desarrollo <span class="text-accent">*</span>
								</label>
								<input
									class="w-full rounded-input border border-outline bg-surface-tinted px-4 py-3 font-body-md text-body-md text-text transition-all focus:border-accent focus:bg-surface focus:outline-none"
									id="project-location"
									placeholder="Ej. Cieneguilla, Lima / Chiclayo"
									required
									type="text"
								/>
							</div>
						</div>
					</div>

					<!-- Sección 3: Canal Directo y Mensaje -->
					<div class="space-y-4 pt-2">
						<div class="flex items-center gap-2.5 border-b border-outline pb-3">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent/15 font-label-sm text-label-sm font-bold text-accent">
								03
							</span>
							<h3 class="font-title-md text-title-md font-bold text-primary">Canal Directo y Mensaje</h3>
						</div>

						<div class="space-y-4">
							<div>
								<label class="mb-1.5 block font-label-md text-label-md font-semibold text-text" for="phone-whatsapp">
									Teléfono / WhatsApp directo <span class="text-accent">*</span>
								</label>
								<input
									class="w-full rounded-input border border-outline bg-surface-tinted px-4 py-3 font-body-md text-body-md text-text transition-all focus:border-accent focus:bg-surface focus:outline-none"
									id="phone-whatsapp"
									placeholder="+51 900 000 000"
									required
									type="tel"
								/>
							</div>

							<div>
								<label class="mb-1.5 block font-label-md text-label-md font-semibold text-text" for="project-notes">
									Estado actual del proyecto y objetivos de venta
								</label>
								<textarea
									class="w-full resize-none rounded-input border border-outline bg-surface-tinted p-4 font-body-md text-body-md text-text leading-relaxed transition-all focus:border-accent focus:bg-surface focus:outline-none"
									id="project-notes"
									placeholder="Coméntanos brevemente si el proyecto está en preventa, entrega inmediata, o si requieres estructuración del showroom..."
									rows="3"
								></textarea>
							</div>
						</div>
					</div>

					<!-- Botón de Envío y Disclaimer -->
					<div class="space-y-3 pt-2">
						<button
							class="group flex w-full cursor-pointer items-center justify-center gap-2 rounded-pill bg-accent px-8 py-4 font-label-md text-label-md font-semibold text-white shadow-level-1 transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent-hover hover:shadow-cta-hover"
							type="submit"
						>
							<span>Agendar reunión de presentación de proyecto</span>
							<span class="material-symbols-outlined text-[20px] transition-transform group-hover:translate-x-1">
								calendar_month
							</span>
						</button>

						<p class="flex items-center justify-center gap-1.5 text-center font-caption text-caption text-text-muted">
							<span class="material-symbols-outlined text-[15px] text-accent">lock</span>
							<span>Sin compromiso inicial. Tratamiento confidencial bajo acuerdo de reserva institucional.</span>
						</p>
					</div>
				</form>

				<!-- Success Notification Banner -->
				<div
					class="hidden mt-6 items-center gap-4 rounded-xl border border-status-available-border bg-status-available-bg p-4 text-status-available-text"
					id="b2b-success-alert"
				>
					<span class="material-symbols-outlined text-[28px] text-accent">check_circle</span>
					<div>
						<p class="font-title-md text-title-md font-bold text-primary">¡Solicitud recibida con éxito!</p>
						<p class="font-body-sm text-body-sm text-text-muted">
							Un director de alianzas se comunicará por WhatsApp o correo en menos de 24 horas hábiles.
						</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById('dev-contact-form');
	const alertBox = document.getElementById('b2b-success-alert');

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (alertBox) {
			alertBox.classList.remove('hidden');
			alertBox.classList.add('flex');
			alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		}
	});
</script>
