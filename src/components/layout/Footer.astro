---
const columns = [
	{
		title: 'Proyectos',
		links: [
			{ label: 'Terrenos y lotes campestres', href: '/#categorias' },
			{ label: 'Departamentos urbanos', href: '/#categorias' },
			{ label: 'Casas de campo & playa', href: '/#categorias' },
			{ label: 'Próximos lanzamientos', href: '/#proyectos-destacados' },
		],
	},
	{
		title: 'Para Desarrolladores',
		links: [
			{ label: 'Showrooms digitales inmersivos', href: '/#showroom-demo' },
			{ label: 'Comercialización integral', href: '/para-desarrolladores' },
			{ label: 'Calificación y gestión de leads', href: '/para-desarrolladores' },
			{ label: 'Agendar reunión B2B', href: '/#b2b-desarrolladores' },
		],
	},
	{
		title: 'Legal & Transparencia',
		links: [
			{ label: 'Términos de servicio', href: '#' },
			{ label: 'Política de privacidad', href: '#' },
			{ label: 'Auditoría de licencias', href: '#' },
			{ label: 'Libro de reclamaciones', href: '#' },
		],
	},
];

const socials = ['public', 'photo_camera', 'forum'];
---

<footer class="w-full border-t border-outline bg-surface-tinted">
	<div class="container-page py-3xl">
		<div class="grid grid-cols-1 gap-2xl md:grid-cols-2 lg:grid-cols-12">
			<div class="flex flex-col gap-md lg:col-span-5">
				<span class="font-display text-title-lg font-bold text-primary">Montara</span>
				<p class="max-w-[24rem] font-body-md text-body-md text-text-muted leading-relaxed">
					Plataforma comercial para proyectos inmobiliarios de alta proyección en Chiclayo y el
					norte del Perú. Arquitectura, seguridad patrimonial y transparencia institucional.
				</p>
				<div class="flex items-center gap-3 pt-2 text-accent">
					{
						socials.map((icon) => (
							<span class="material-symbols-outlined text-[20px]">{icon}</span>
						))
					}
				</div>
			</div>

			{
				columns.map((col) => (
					<div class="flex flex-col gap-md lg:col-span-2 last:lg:col-span-3">
						<h4 class="font-title-md text-title-md font-semibold tracking-tight text-text">
							{col.title}
						</h4>
						<ul class="flex flex-col gap-2.5 font-body-sm text-body-sm text-text-muted">
							{col.links.map((link) => (
								<li>
									<a class="block py-0.5 transition-colors hover:text-accent" href={link.href}>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div class="mt-2xl flex flex-col gap-2 border-t border-outline pt-lg text-caption text-text-muted md:flex-row md:items-center md:justify-between">
			<span>© {new Date().getFullYear()} Montara Inmobiliaria. Todos los derechos reservados.</span>
			<span>Chiclayo · Pimentel · Lambayeque, Perú</span>
		</div>
	</div>
</footer>
