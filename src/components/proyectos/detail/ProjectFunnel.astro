---
import type { Project } from '../../../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<section class="w-full bg-surface py-20 lg:py-28 border-b border-outline" id="cotizador-funnel">
	<div class="container-page max-w-[56rem]">
		<!-- Funnel Header -->
		<div class="mx-auto mb-12 flex flex-col gap-3 text-center">
			<span class="font-caption text-caption uppercase font-semibold text-accent tracking-wider">
				Asesoría &amp; Disponibilidad
			</span>
			<h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-primary tracking-tight">
				Cotiza y evalúa tu inversión en {project.title}
			</h2>
			<p class="font-body-md text-body-md text-text-muted max-w-[36rem] mx-auto">
				Completa este breve test interactivo de 1 minuto para recibir una cotización a tu medida, disponibilidad exacta y planes de financiamiento directo sin bancos.
			</p>
		</div>

		<!-- Funnel Card Container -->
		<div class="rounded-card border border-outline bg-surface-tinted shadow-level-3 overflow-hidden">
			<!-- Wizard Progress Bar Header -->
			<div class="flex items-center justify-between bg-surface px-6 py-4 border-b border-outline">
				<div class="flex items-center gap-3">
					<span
						id="step-number-indicator"
						class="flex h-7 w-7 items-center justify-center rounded-full bg-accent font-label-sm text-label-sm font-bold text-white shadow-sm"
					>
						1
					</span>
					<span id="step-title-indicator" class="font-title-md text-title-md font-semibold text-primary">
						Paso 1 de 5: Objetivo de Inversión
					</span>
				</div>
				<div class="h-2 w-32 overflow-hidden rounded-full bg-outline/60">
					<div id="funnel-progress" class="h-full bg-accent transition-all duration-300 w-1/5"></div>
				</div>
			</div>

			<form id="project-funnel-form" class="p-6 md:p-10">
				<!-- STEP 1: OBJETIVO -->
				<div class="funnel-step" data-step="1">
					<h3 class="font-title-lg text-title-lg font-bold text-primary mb-2">¿Cuál es tu objetivo principal con este terreno?</h3>
					<p class="font-body-md text-body-md text-text-muted mb-6">Selecciona la opción que mejor describa tu horizonte para el proyecto.</p>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-accent bg-accent/10 transition-all flex flex-col justify-between">
							<input type="radio" name="goal" value="inversion" checked class="sr-only" />
							<div class="flex items-start justify-between">
								<span class="material-symbols-outlined text-accent text-[28px]">trending_up</span>
								<div class="radio-indicator flex h-5 w-5 items-center justify-center rounded-full border border-accent bg-surface">
									<div class="radio-dot h-2.5 w-2.5 rounded-full bg-accent"></div>
								</div>
							</div>
							<div class="mt-4">
								<span class="block font-title-md text-title-md font-bold text-primary">Inversión &amp; Plusvalía</span>
								<span class="font-body-sm text-body-sm text-text-muted">Generar rentabilidad y resguardar capital patrimonial.</span>
							</div>
						</label>

						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-outline bg-surface transition-all flex flex-col justify-between hover:border-outline-accent">
							<input type="radio" name="goal" value="casa_campo" class="sr-only" />
							<div class="flex items-start justify-between">
								<span class="material-symbols-outlined text-accent text-[28px]">cottage</span>
								<div class="radio-indicator flex h-5 w-5 items-center justify-center rounded-full border border-outline bg-surface">
									<div class="radio-dot h-2.5 w-2.5 rounded-full bg-transparent"></div>
								</div>
							</div>
							<div class="mt-4">
								<span class="block font-title-md text-title-md font-bold text-primary">Casa de Campo</span>
								<span class="font-body-sm text-body-sm text-text-muted">Construir residencia de fin de semana o descanso familiar.</span>
							</div>
						</label>

						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-outline bg-surface transition-all flex flex-col justify-between hover:border-outline-accent">
							<input type="radio" name="goal" value="explorando" class="sr-only" />
							<div class="flex items-start justify-between">
								<span class="material-symbols-outlined text-accent text-[28px]">explore</span>
								<div class="radio-indicator flex h-5 w-5 items-center justify-center rounded-full border border-outline bg-surface">
									<div class="radio-dot h-2.5 w-2.5 rounded-full bg-transparent"></div>
								</div>
							</div>
							<div class="mt-4">
								<span class="block font-title-md text-title-md font-bold text-primary">Explorando Opciones</span>
								<span class="font-body-sm text-body-sm text-text-muted">Conocer precios y comparar con otros proyectos en la región.</span>
							</div>
						</label>
					</div>
				</div>

				<!-- STEP 2: PRESUPUESTO ESTIMADO -->
				<div class="funnel-step hidden" data-step="2">
					<h3 class="font-title-lg text-title-lg font-bold text-primary mb-2">Presupuesto estimado de inversión</h3>
					<p class="font-body-md text-body-md text-text-muted mb-6">Nos ayuda a ubicar los lotes que mejor encajan con tu capacidad.</p>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-accent bg-accent/10 transition-all flex flex-col justify-between">
							<input type="radio" name="budget" value="35k-45k" checked class="sr-only" />
							<div class="flex items-start justify-between">
								<span class="material-symbols-outlined text-accent text-[28px]">attach_money</span>
								<div class="radio-indicator flex h-5 w-5 items-center justify-center rounded-full border border-accent bg-surface">
									<div class="radio-dot h-2.5 w-2.5 rounded-full bg-accent"></div>
								</div>
							</div>
							<div class="mt-4">
								<span class="block font-title-md text-title-md font-bold text-primary">$35,000 - $45,000 USD</span>
								<span class="font-body-sm text-body-sm text-text-muted">Lotes estándar de 500 m² a 600 m²</span>
							</div>
						</label>

						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-outline bg-surface transition-all flex flex-col justify-between hover:border-outline-accent">
							<input type="radio" name="budget" value="45k-60k" class="sr-only" />
							<div class="flex items-start justify-between">
								<span class="material-symbols-outlined text-accent text-[28px]">payments</span>
								<div class="radio-indicator flex h-5 w-5 items-center justify-center rounded-full border border-outline bg-surface">
									<div class="radio-dot h-2.5 w-2.5 rounded-full bg-transparent"></div>
								</div>
							</div>
							<div class="mt-4">
								<span class="block font-title-md text-title-md font-bold text-primary">$45,000 - $60,000 USD</span>
								<span class="font-body-sm text-body-sm text-text-muted">Lotes esquinas de 600 m² a 900 m² y frente a parque</span>
							</div>
						</label>

						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-outline bg-surface transition-all flex flex-col justify-between hover:border-outline-accent">
							<input type="radio" name="budget" value="60k+" class="sr-only" />
							<div class="flex items-start justify-between">
								<span class="material-symbols-outlined text-accent text-[28px]">diamond</span>
								<div class="radio-indicator flex h-5 w-5 items-center justify-center rounded-full border border-outline bg-surface">
									<div class="radio-dot h-2.5 w-2.5 rounded-full bg-transparent"></div>
								</div>
							</div>
							<div class="mt-4">
								<span class="block font-title-md text-title-md font-bold text-primary">Más de $60,000 USD</span>
								<span class="font-body-sm text-body-sm text-text-muted">Lotes amplios de 1,000 m² o lotes dobles</span>
							</div>
						</label>
					</div>
				</div>

				<!-- STEP 3: FORMA DE PAGO -->
				<div class="funnel-step hidden" data-step="3">
					<h3 class="font-title-lg text-title-lg font-bold text-primary mb-2">Forma de pago proyectada</h3>
					<p class="font-body-md text-body-md text-text-muted mb-6">{project.title} ofrece esquemas flexibles según tu liquidez.</p>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-accent bg-accent/10 transition-all flex items-center justify-between">
							<div class="flex items-center gap-4">
								<span class="material-symbols-outlined text-accent text-[28px]">savings</span>
								<div>
									<span class="block font-title-md text-title-md font-bold text-primary">Pago al contado</span>
									<span class="font-body-sm text-body-sm text-text-muted">Con descuento especial por cierre</span>
								</div>
							</div>
							<input type="radio" name="payment_mode" value="contado" checked class="sr-only" />
							<div class="radio-indicator flex h-5 w-5 items-center justify-center rounded-full border border-accent bg-surface">
								<div class="radio-dot h-2.5 w-2.5 rounded-full bg-accent"></div>
							</div>
						</label>

						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-outline bg-surface transition-all flex items-center justify-between hover:border-outline-accent">
							<div class="flex items-center gap-4">
								<span class="material-symbols-outlined text-accent text-[28px]">handshake</span>
								<div>
									<span class="block font-title-md text-title-md font-bold text-primary">Financiamiento directo</span>
									<span class="font-body-sm text-body-sm text-text-muted">Sin bancos, cuotas hasta 36 meses</span>
								</div>
							</div>
							<input type="radio" name="payment_mode" value="directo" class="sr-only" />
							<div class="radio-indicator flex h-5 w-5 items-center justify-center rounded-full border border-outline bg-surface">
								<div class="radio-dot h-2.5 w-2.5 rounded-full bg-transparent"></div>
							</div>
						</label>

						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-outline bg-surface transition-all flex items-center justify-between hover:border-outline-accent">
							<div class="flex items-center gap-4">
								<span class="material-symbols-outlined text-accent text-[28px]">account_balance</span>
								<div>
									<span class="block font-title-md text-title-md font-bold text-primary">Crédito bancario</span>
									<span class="font-body-sm text-body-sm text-text-muted">Evaluación con entidad financiera</span>
								</div>
							</div>
							<input type="radio" name="payment_mode" value="banco" class="sr-only" />
							<div class="radio-indicator flex h-5 w-5 items-center justify-center rounded-full border border-outline bg-surface">
								<div class="radio-dot h-2.5 w-2.5 rounded-full bg-transparent"></div>
							</div>
						</label>

						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-outline bg-surface transition-all flex items-center justify-between hover:border-outline-accent">
							<div class="flex items-center gap-4">
								<span class="material-symbols-outlined text-accent text-[28px]">contact_support</span>
								<div>
									<span class="block font-title-md text-title-md font-bold text-primary">Deseo asesoría previa</span>
									<span class="font-body-sm text-body-sm text-text-muted">Evaluar la mejor opción con un especialista</span>
								</div>
							</div>
							<input type="radio" name="payment_mode" value="asesoria" class="sr-only" />
							<div class="radio-indicator flex h-5 w-5 items-center justify-center rounded-full border border-outline bg-surface">
								<div class="radio-dot h-2.5 w-2.5 rounded-full bg-transparent"></div>
							</div>
						</label>
					</div>
				</div>

				<!-- STEP 4: HORIZONTE DE TIEMPO -->
				<div class="funnel-step hidden" data-step="4">
					<h3 class="font-title-lg text-title-lg font-bold text-primary mb-2">Plazo estimado para la toma de decisión</h3>
					<p class="font-body-md text-body-md text-text-muted mb-6">Nos permite priorizar tu cita y la reserva temporal de metraje.</p>
					<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-accent bg-accent/10 transition-all text-center">
							<input type="radio" name="timeframe" value="inmediato" checked class="sr-only" />
							<div class="radio-indicator mx-auto mb-2 flex h-6 w-6 items-center justify-center rounded-full border border-accent bg-surface">
								<div class="radio-dot h-3 w-3 rounded-full bg-accent"></div>
							</div>
							<span class="block font-title-md text-title-md font-bold text-primary">Este mes</span>
							<span class="font-body-sm text-body-sm text-text-muted">Prioridad inmediata</span>
						</label>

						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-outline bg-surface transition-all text-center hover:border-outline-accent">
							<input type="radio" name="timeframe" value="1-3m" class="sr-only" />
							<div class="radio-indicator mx-auto mb-2 flex h-6 w-6 items-center justify-center rounded-full border border-outline bg-surface">
								<div class="radio-dot h-3 w-3 rounded-full bg-transparent"></div>
							</div>
							<span class="block font-title-md text-title-md font-bold text-primary">1 a 3 meses</span>
							<span class="font-body-sm text-body-sm text-text-muted">Evaluando opciones</span>
						</label>

						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-outline bg-surface transition-all text-center hover:border-outline-accent">
							<input type="radio" name="timeframe" value="3-6m" class="sr-only" />
							<div class="radio-indicator mx-auto mb-2 flex h-6 w-6 items-center justify-center rounded-full border border-outline bg-surface">
								<div class="radio-dot h-3 w-3 rounded-full bg-transparent"></div>
							</div>
							<span class="block font-title-md text-title-md font-bold text-primary">3 a 6 meses</span>
							<span class="font-body-sm text-body-sm text-text-muted">Mediano plazo</span>
						</label>

						<label class="funnel-label cursor-pointer p-5 rounded-2xl border border-outline bg-surface transition-all text-center hover:border-outline-accent">
							<input type="radio" name="timeframe" value="solo_info" class="sr-only" />
							<div class="radio-indicator mx-auto mb-2 flex h-6 w-6 items-center justify-center rounded-full border border-outline bg-surface">
								<div class="radio-dot h-3 w-3 rounded-full bg-transparent"></div>
							</div>
							<span class="block font-title-md text-title-md font-bold text-primary">Solo información</span>
							<span class="font-body-sm text-body-sm text-text-muted">Revisión preliminar</span>
						</label>
					</div>
				</div>

				<!-- STEP 5: DATOS DE CONTACTO PRIORITARIO -->
				<div class="funnel-step hidden" data-step="5">
					<h3 class="font-title-lg text-title-lg font-bold text-primary mb-2">¿A dónde enviamos tu cotización y disponibilidad?</h3>
					<p class="font-body-md text-body-md text-text-muted mb-6">Un asesor asignado de Montara Inmobiliaria te enviará la propuesta detallada en PDF por WhatsApp.</p>
					<div class="space-y-4 max-w-[32rem]">
						<div>
							<label class="mb-1 block font-label-sm text-label-sm font-semibold text-primary">Nombre y Apellidos *</label>
							<div class="relative">
								<span class="material-symbols-outlined absolute left-3 top-3 text-[20px] text-text-muted">person</span>
								<input
									type="text"
									required
									placeholder="Ej. Carlos Mendoza"
									class="h-12 w-full rounded-xl border border-outline bg-surface pl-10 pr-4 font-body-md text-primary outline-none focus:border-accent shadow-sm"
								/>
							</div>
						</div>
						<div>
							<label class="mb-1 block font-label-sm text-label-sm font-semibold text-primary">WhatsApp de contacto directo *</label>
							<div class="relative">
								<span class="material-symbols-outlined absolute left-3 top-3 text-[20px] text-accent">chat</span>
								<input
									type="tel"
									required
									placeholder="+51 987 654 321"
									class="h-12 w-full rounded-xl border border-outline bg-surface pl-10 pr-4 font-body-md text-primary outline-none focus:border-accent shadow-sm"
								/>
							</div>
							<span class="mt-1 block font-caption text-caption text-text-muted">Recibirás el brochure de precios y el plano actualizado vía WhatsApp.</span>
						</div>
						<div>
							<label class="mb-1 block font-label-sm text-label-sm font-semibold text-primary">Correo Electrónico (Opcional)</label>
							<div class="relative">
								<span class="material-symbols-outlined absolute left-3 top-3 text-[20px] text-text-muted">mail</span>
								<input
									type="email"
									placeholder="carlos@empresa.pe"
									class="h-12 w-full rounded-xl border border-outline bg-surface pl-10 pr-4 font-body-md text-primary outline-none focus:border-accent shadow-sm"
								/>
							</div>
						</div>
						<div class="flex items-start gap-3 rounded-xl bg-surface p-4 border border-outline font-caption text-caption text-text-muted">
							<span class="material-symbols-outlined text-[18px] text-accent shrink-0 mt-0.5">lock</span>
							<span>Tus datos son tratados bajo estricta confidencialidad exclusivamente para {project.title} y Montara Inmobiliaria.</span>
						</div>
					</div>
				</div>

				<!-- Wizard Step Navigation Buttons -->
				<div class="mt-8 flex items-center justify-between gap-4 pt-6 border-t border-outline/60">
					<button
						type="button"
						id="btn-funnel-prev"
						class="inline-flex items-center gap-1 rounded-pill bg-surface border border-outline px-6 py-2.5 font-label-md text-label-md font-medium text-primary transition-colors hover:bg-surface-tinted invisible"
					>
						<span class="material-symbols-outlined text-[18px]">arrow_back</span>
						<span>Atrás</span>
					</button>

					<button
						type="button"
						id="btn-funnel-next"
						class="inline-flex items-center gap-1 rounded-pill bg-accent px-6 py-2.5 font-label-md text-label-md font-semibold text-white shadow-sm transition-all hover:bg-accent-hover"
					>
						<span>Continuar</span>
						<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
					</button>

					<button
						type="submit"
						id="btn-funnel-submit"
						class="inline-flex items-center gap-2 rounded-pill bg-accent px-8 py-2.5 font-label-md text-label-md font-semibold text-white shadow-md transition-all hover:bg-accent-hover hidden"
					>
						<span class="material-symbols-outlined text-[18px]">send</span>
						<span>Solicitar cotización</span>
					</button>
				</div>
			</form>
		</div>
	</div>
</section>

<script is:inline>
	(function() {
		var currentStep = 1;
		var totalSteps = 5;
		var stepTitles = [
			'Paso 1 de 5: Objetivo de Inversión',
			'Paso 2 de 5: Presupuesto Estimado',
			'Paso 3 de 5: Forma de Pago',
			'Paso 4 de 5: Horizonte de Decisión',
			'Paso 5 de 5: Datos de Contacto',
		];

		function updateStepUI() {
			var steps = document.querySelectorAll('.funnel-step');
			for (var i = 0; i < steps.length; i++) {
				steps[i].classList.add('hidden');
			}
			var activeEl = document.querySelector('.funnel-step[data-step="' + currentStep + '"]');
			if (activeEl) activeEl.classList.remove('hidden');

			var numElem = document.getElementById('step-number-indicator');
			var titleElem = document.getElementById('step-title-indicator');
			var progressElem = document.getElementById('funnel-progress');
			var prevBtn = document.getElementById('btn-funnel-prev');
			var nextBtn = document.getElementById('btn-funnel-next');
			var submitBtn = document.getElementById('btn-funnel-submit');

			if (numElem) numElem.innerText = currentStep.toString();
			if (titleElem) titleElem.innerText = stepTitles[currentStep - 1];
			if (progressElem) progressElem.style.width = (currentStep / totalSteps * 100) + '%';

			if (prevBtn) {
				if (currentStep === 1) prevBtn.classList.add('invisible');
				else prevBtn.classList.remove('invisible');
			}

			if (currentStep === totalSteps) {
				if (nextBtn) nextBtn.classList.add('hidden');
				if (submitBtn) submitBtn.classList.remove('hidden');
			} else {
				if (nextBtn) nextBtn.classList.remove('hidden');
				if (submitBtn) submitBtn.classList.add('hidden');
			}
		}

		var nextBtn = document.getElementById('btn-funnel-next');
		var prevBtn = document.getElementById('btn-funnel-prev');
		var form = document.getElementById('project-funnel-form');

		if (nextBtn) {
			nextBtn.addEventListener('click', function() {
				if (currentStep < totalSteps) {
					currentStep++;
					updateStepUI();
				}
			});
		}

		if (prevBtn) {
			prevBtn.addEventListener('click', function() {
				if (currentStep > 1) {
					currentStep--;
					updateStepUI();
				}
			});
		}

		var radios = document.querySelectorAll('.funnel-step input[type="radio"]');
		for (var j = 0; j < radios.length; j++) {
			radios[j].addEventListener('change', function(e) {
				var target = e.target;
				var stepContainer = target.closest('.funnel-step');
				if (!stepContainer) return;

				var labels = stepContainer.querySelectorAll('label');
				for (var k = 0; k < labels.length; k++) {
					labels[k].classList.remove('border-accent', 'bg-accent/10');
					labels[k].classList.add('border-outline', 'bg-surface');
					var dot = labels[k].querySelector('.radio-dot');
					if (dot) {
						dot.classList.remove('bg-accent');
						dot.classList.add('bg-transparent');
					}
				}

				var activeLabel = target.closest('label');
				if (activeLabel) {
					activeLabel.classList.remove('border-outline', 'bg-surface');
					activeLabel.classList.add('border-accent', 'bg-accent/10');
					var activeDot = activeLabel.querySelector('.radio-dot');
					if (activeDot) {
						activeDot.classList.remove('bg-transparent');
						activeDot.classList.add('bg-accent');
					}
				}
			});
		}

		if (form) {
			form.addEventListener('submit', function(e) {
				e.preventDefault();
				alert('¡Gracias por tu solicitud! Un asesor de Montara Inmobiliaria se pondrá en contacto contigo a la brevedad con la cotización oficial.');
				form.reset();
				currentStep = 1;
				updateStepUI();
			});
		}
	})();
</script>
