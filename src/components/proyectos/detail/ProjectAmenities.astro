---

<section class="w-full bg-background py-20 lg:py-28 border-b border-outline">
	<div class="container-page">
		<div class="mx-auto mb-16 flex max-w-[48rem] flex-col gap-3 text-center">
			<span class="font-caption text-caption uppercase font-semibold text-accent tracking-wider">
				Equipamiento Residencial
			</span>
			<h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-primary tracking-tight">
				Amenidades Proyectadas con Sentido Arquitectónico
			</h2>
			<p class="font-body-md text-body-md text-text-muted">
				Infraestructura campestre diseñada para promover bienestar integral, privacidad absoluta y una experiencia residencial de alto estándar.
			</p>
		</div>

		<!-- Amenities Grid -->
		<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
			{
				amenitiesList.map((item) => (
					<div class="group flex flex-col rounded-card border border-outline/80 bg-surface shadow-level-1 overflow-hidden transition-all duration-300 hover:shadow-level-2 hover:border-accent/40">
						<div class="relative h-52 w-full overflow-hidden bg-surface-tinted">
							<img
								class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
								alt={item.title}
								src={item.image}
							/>
							<div class="absolute top-4 left-4 flex h-10 w-10 items-center justify-center rounded-xl bg-surface/90 text-accent backdrop-blur-md border border-outline shadow-sm">
								<span class="material-symbols-outlined text-[22px]">{item.icon}</span>
							</div>
						</div>
						<div class="flex flex-col gap-2 p-6">
							<h3 class="font-title-lg text-title-lg font-bold text-primary">{item.title}</h3>
							<p class="font-body-md text-body-md text-text-muted leading-relaxed">{item.desc}</p>
						</div>
					</div>
				))
			}

			<!-- Amenity 6: Montara Trust Badge Card -->
			<div class="flex flex-col justify-between rounded-card border border-primary-elevated bg-primary p-8 text-white shadow-level-2">
				<div>
					<div class="mb-6 flex h-12 w-12 items-center justify-center rounded-xl bg-accent/20 text-accent border border-accent/30">
						<span class="material-symbols-outlined text-[28px]">verified_user</span>
					</div>
					<h3 class="mb-2 font-title-lg text-title-lg font-bold text-white">Comercializado bajo estándar Montara</h3>
					<p class="font-body-md text-body-md text-white/80 leading-relaxed">
						Evaluamos exhaustivamente la titulación, permisos y viabilidad física de cada proyecto antes de presentarlo a nuestra comunidad inversora.
					</p>
				</div>
				<div class="mt-8 flex items-center gap-2 pt-4 font-label-md text-label-md font-semibold text-accent border-t border-primary-elevated">
					<span>Seguridad patrimonial transparente</span>
					<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
				</div>
			</div>
		</div>
	</div>
</section>
