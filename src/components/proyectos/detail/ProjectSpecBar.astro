---
import type { Project } from '../../../data/projects';

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<section class="w-full bg-surface py-10 border-b border-outline">
	<div class="container-page">
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
			<div class="flex flex-col justify-between rounded-2xl border border-outline bg-surface-tinted p-5 shadow-level-1">
				<span class="font-caption text-caption uppercase tracking-wider text-text-muted">Metraje de Lotes</span>
				<div class="mt-2">
					<p class="font-title-lg text-title-lg font-bold text-primary">500 a 1,200 m²</p>
					<p class="font-body-sm text-body-sm text-text-muted">Lotes estándar y esquinas VIP</p>
				</div>
			</div>

			<div class="flex flex-col justify-between rounded-2xl border border-outline bg-surface-tinted p-5 shadow-level-1">
				<span class="font-caption text-caption uppercase tracking-wider text-text-muted">Tipología</span>
				<div class="mt-2">
					<p class="font-title-lg text-title-lg font-bold text-primary">{project.typeLabel || 'Condominio Campestre'}</p>
					<p class="font-body-sm text-body-sm text-text-muted">Reglamento de convivencia &amp; verde</p>
				</div>
			</div>

			<div class="flex flex-col justify-between rounded-2xl border border-outline bg-surface-tinted p-5 shadow-level-1">
				<span class="font-caption text-caption uppercase tracking-wider text-text-muted">Estado Técnico</span>
				<div class="mt-2">
					<p class="font-title-lg text-title-lg font-bold text-accent flex items-center gap-2">
						<span class="h-2.5 w-2.5 rounded-full bg-accent animate-pulse"></span>
						<span>Obras Iniciales</span>
					</p>
					<p class="font-body-sm text-body-sm text-text-muted">Trazado vial &amp; cerco vivo</p>
				</div>
			</div>

			<div class="flex flex-col justify-between rounded-2xl border border-outline bg-surface-tinted p-5 shadow-level-1">
				<span class="font-caption text-caption uppercase tracking-wider text-text-muted">Ubicación Precisa</span>
				<div class="mt-2">
					<p class="font-title-lg text-title-lg font-bold text-primary">Carretera Reque Km 12</p>
					<p class="font-body-sm text-body-sm text-text-muted">Fácil acceso asfaltado</p>
				</div>
			</div>
		</div>
	</div>
</section>
