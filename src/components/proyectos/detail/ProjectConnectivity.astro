---
---

<section class="w-full bg-surface py-20 lg:py-28 border-b border-outline">
	<div class="container-page">
		<div class="grid grid-cols-1 items-center gap-gutter-desktop lg:grid-cols-12">
			<!-- Location Narrative & Metrics -->
			<div class="flex flex-col gap-6 lg:col-span-5">
				<div class="flex flex-col gap-2">
					<span class="font-caption text-caption font-semibold uppercase tracking-wider text-accent">
						Ubicación Estratégica
					</span>
					<h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg font-bold text-primary tracking-tight max-w-[40rem]">
						Conectividad y Entorno
					</h2>
				</div>
				<p class="font-body-md text-body-md text-text-muted leading-relaxed">
					Finca Sevilla se posiciona en el corredor campestre sur de Chiclayo, una zona de altísima valorización con accesos directos asfaltados y cercanía inmediata a servicios metropolitanos esenciales.
				</p>

				<!-- Commute Times List -->
				<div class="space-y-3 pt-2">
					<div class="flex items-center justify-between p-4 rounded-2xl bg-surface-tinted border border-outline shadow-level-1">
						<div class="flex items-center gap-3">
							<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface text-primary border border-outline">
								<span class="material-symbols-outlined text-[20px]">storefront</span>
							</div>
							<div>
								<h4 class="font-title-md text-title-md font-semibold text-primary">Real Plaza Chiclayo</h4>
								<span class="font-caption text-caption text-text-muted">Centro financiero, gastronomía y retail</span>
							</div>
						</div>
						<span class="font-title-md text-title-md font-bold text-accent">25 min</span>
					</div>

					<div class="flex items-center justify-between p-4 rounded-2xl bg-surface-tinted border border-outline shadow-level-1">
						<div class="flex items-center gap-3">
							<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface text-primary border border-outline">
								<span class="material-symbols-outlined text-[20px]">local_hospital</span>
							</div>
							<div>
								<h4 class="font-title-md text-title-md font-semibold text-primary">Hospital Regional y Campus USAT</h4>
								<span class="font-caption text-caption text-text-muted">Salud integral y educación universitaria</span>
							</div>
						</div>
						<span class="font-title-md text-title-md font-bold text-accent">15 min</span>
					</div>

					<div class="flex items-center justify-between p-4 rounded-2xl bg-surface-tinted border border-outline shadow-level-1">
						<div class="flex items-center gap-3">
							<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface text-primary border border-outline">
								<span class="material-symbols-outlined text-[20px]">alt_route</span>
							</div>
							<div>
								<h4 class="font-title-md text-title-md font-semibold text-primary">Acceso Panamericana Norte</h4>
								<span class="font-caption text-caption text-text-muted">Conexión directa interprovincial y aeroportuaria</span>
							</div>
						</div>
						<span class="font-title-md text-title-md font-bold text-accent">10 min</span>
					</div>

					<div class="flex items-center justify-between p-4 rounded-2xl bg-surface-tinted border border-outline shadow-level-1">
						<div class="flex items-center gap-3">
							<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface text-primary border border-outline">
								<span class="material-symbols-outlined text-[20px]">beach_access</span>
							</div>
							<div>
								<h4 class="font-title-md text-title-md font-semibold text-primary">Balneario de Pimentel</h4>
								<span class="font-caption text-caption text-text-muted">Malecón costero, deportes y surf</span>
							</div>
						</div>
						<span class="font-title-md text-title-md font-bold text-accent">35 min</span>
					</div>
				</div>
			</div>

			<!-- Visual Styled Map Section -->
			<div class="lg:col-span-7">
				<div class="relative h-[460px] overflow-hidden rounded-card border border-outline bg-surface-tinted shadow-level-2">
					<div
						class="h-full w-full bg-cover bg-center"
						style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDZybve2SCCSlPcVmKvWxUqe3eN-GAmQR-W_nxG_EsHjeda0ABlJT0Xu6ex9osWIDRDkHZVZD4Kg0k6QUaJbRHs5ZUYCm6DiNdBhHVHhu-sjWJ7Iw9f5jP7tJ_5wccNKsboyt_eVRoNEFe_A9eiRlhD797TreW5OoKTeP8-76jE_Dm4WLntMWImr6YK4R2qdRZZjBMc7agPipNpv0ocQYnzeMB80alW-OxxqCpCkEbHEiIqayZF71DNvg')"
					>
					</div>
					<!-- Floating Overlay Card on Map -->
					<div class="absolute top-6 left-6 p-5 rounded-2xl bg-surface/95 backdrop-blur-md shadow-level-2 border border-outline max-w-[20rem]">
						<div class="mb-1 flex items-center gap-2 font-label-sm text-label-sm font-semibold text-accent">
							<span class="h-2 w-2 rounded-full bg-accent"></span>
							<span>Ubicación Estratégica</span>
						</div>
						<h5 class="font-title-md text-title-md font-bold text-primary">Sector Campestre Reque</h5>
						<p class="mt-1 font-body-sm text-body-sm text-text-muted">
							Lejos del ruido urbano de la ciudad pero perfectamente comunicado por autopista asfaltada.
						</p>
						<div class="mt-3 pt-2 text-outline-strong font-caption text-caption flex items-center gap-1 border-t border-outline/50">
							<span class="material-symbols-outlined text-[14px]">my_location</span> Lat: -6.8653, Lon: -79.8241
						</div>
					</div>
					<div class="absolute bottom-6 right-6">
						<a
							class="inline-flex items-center gap-2 rounded-pill bg-primary px-5 py-2.5 font-label-sm text-label-sm font-semibold text-white shadow-level-2 hover:bg-primary-elevated transition-all"
							href="https://maps.google.com"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="material-symbols-outlined text-[16px]">map</span>
							<span>Abrir en Google Maps</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
