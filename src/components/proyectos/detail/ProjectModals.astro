---

<!-- MODAL: AGENDAR VISITA GUIADA -->
<div id="modal-visita" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-primary/80 backdrop-blur-sm">
	<div class="relative w-full max-w-md rounded-card border border-outline bg-surface p-6 md:p-8 shadow-level-3">
		<button
			class="absolute top-4 right-4 text-text-muted transition-colors hover:text-primary"
			onclick="document.getElementById('modal-visita')?.classList.add('hidden')"
			type="button"
		>
			<span class="material-symbols-outlined text-[24px]">close</span>
		</button>
		<div class="mb-1 flex items-center gap-2 font-label-sm text-label-sm font-semibold text-accent">
			<span class="material-symbols-outlined text-[18px]">calendar_today</span>
			<span>Visita en Campo</span>
		</div>
		<h3 class="mb-2 font-title-lg text-title-lg font-bold text-primary">Agendar visita guiada a {project.title}</h3>
		<p class="mb-6 font-body-sm text-body-sm text-text-muted">
			Contamos con movilidad desde Chiclayo centro los días sábados y domingos para conocer el predio in situ.
		</p>
		<form class="space-y-4" id="visita-form">
			<div>
				<label class="mb-1 block font-label-sm text-label-sm font-semibold text-primary">Tu Nombre Completo</label>
				<input
					type="text"
					required
					placeholder="Carlos Mendoza"
					class="h-11 w-full rounded-xl border border-outline bg-surface-tinted px-3 font-body-md text-primary outline-none focus:border-accent"
				/>
			</div>
			<div>
				<label class="mb-1 block font-label-sm text-label-sm font-semibold text-primary">Teléfono WhatsApp</label>
				<input
					type="tel"
					required
					placeholder="+51 987 654 321"
					class="h-11 w-full rounded-xl border border-outline bg-surface-tinted px-3 font-body-md text-primary outline-none focus:border-accent"
				/>
			</div>
			<div>
				<label class="mb-1 block font-label-sm text-label-sm font-semibold text-primary">Día de preferencia</label>
				<select class="h-11 w-full rounded-xl border border-outline bg-surface-tinted px-3 font-body-md text-primary outline-none focus:border-accent">
					<option>Sábado mañana (10:00 AM)</option>
					<option>Sábado tarde (3:30 PM)</option>
					<option>Domingo mañana (10:00 AM)</option>
					<option>Día de semana (Coordinar privado)</option>
				</select>
			</div>
			<button
				type="submit"
				class="mt-4 w-full rounded-pill bg-accent py-3 font-label-md text-label-md font-semibold text-white shadow-sm transition-all hover:bg-accent-hover"
			>
				Confirmar Solicitud de Visita
			</button>
		</form>
	</div>
</div>

<!-- MODAL: GALERÍA AMPLIADA -->
<div id="modal-gallery" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-primary/85 backdrop-blur-md">
	<div class="relative w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-card border border-outline bg-surface p-6 md:p-8 shadow-level-3">
		<div class="mb-6 flex items-center justify-between border-b border-outline pb-4">
			<h3 class="font-title-lg text-title-lg font-bold text-primary">Renders Arquitectónicos &amp; Avances de {project.title}</h3>
			<button
				class="text-text-muted transition-colors hover:text-primary"
				onclick="document.getElementById('modal-gallery')?.classList.add('hidden')"
				type="button"
			>
				<span class="material-symbols-outlined text-[24px]">close</span>
			</button>
		</div>
		<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3">
			{
				galleryRenders.map((img, idx) => (
					<div class="h-48 overflow-hidden rounded-xl bg-surface-tinted border border-outline">
						<img
							class="h-full w-full object-cover transition-transform duration-300 hover:scale-105"
							alt={`Render ${idx + 1} de ${project.title}`}
							src={img}
						/>
					</div>
				))
			}
		</div>
	</div>
</div>

<script>
	function initModals() {
		const visitaForm = document.getElementById('visita-form');
		if (visitaForm) {
			visitaForm.addEventListener('submit', (e) => {
				e.preventDefault();
				alert('Visita agendada. Nuestro asesor te contactará para confirmar el horario.');
				document.getElementById('modal-visita')?.classList.add('hidden');
			});
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initModals);
	} else {
		initModals();
	}
</script>
