---
---

<section class="w-full bg-surface-tinted py-8 md:py-20 border-t border-outline">
	<div class="container-page">
		<div class="relative overflow-hidden rounded-card bg-gradient-to-br from-primary via-primary-elevated to-primary p-5 md:p-12 lg:p-16 text-white shadow-level-3">
			<!-- Ambient radial glow behind card -->
			<div class="pointer-events-none absolute -bottom-16 -right-16 h-96 w-96 rounded-full bg-accent/25 blur-3xl"></div>
			<div class="pointer-events-none absolute -top-20 left-1/3 h-64 w-64 rounded-full bg-accent/10 blur-2xl"></div>

			<div class="relative z-10 flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center max-md:gap-5">
				<div class="max-w-[44rem]">
					<div class="mb-4 inline-flex items-center gap-2 rounded-pill bg-white/10 px-3.5 py-1 font-caption text-caption font-semibold uppercase tracking-wider text-accent backdrop-blur-md">
						<span class="material-symbols-outlined text-[15px]">support_agent</span>
						<span>Consultoría Patrimonial Directa</span>
					</div>

					<h2 class="font-headline-md text-headline-md font-bold tracking-tight text-white md:text-[34px] md:leading-[42px]">
						¿Buscas una ubicación o presupuesto específico?
					</h2>

					<p class="mt-2 font-body-md text-body-md leading-relaxed text-white/85 md:mt-3 md:font-body-lg md:text-body-lg">
						Nuestros asesores comerciales te ayudan a comparar proyectos, analizar plusvalía por zona y simular alternativas de financiamiento a tu medida sin compromiso.
					</p>

					<div class="mt-4 hidden flex-wrap items-center gap-x-6 gap-y-2 sm:flex md:mt-6 font-body-sm text-body-sm text-white/80">
						<span class="flex items-center gap-1.5">
							<span class="material-symbols-outlined text-[18px] text-accent">check_circle</span>
							Respuesta en menos de 15 min
						</span>
						<span class="flex items-center gap-1.5">
							<span class="material-symbols-outlined text-[18px] text-accent">check_circle</span>
							Masterplans y brochure confidencial
						</span>
						<span class="flex items-center gap-1.5">
							<span class="material-symbols-outlined text-[18px] text-accent">check_circle</span>
							Sin comisiones ocultas
						</span>
					</div>
				</div>

				<!-- High Conversion Action Module -->
				<div class="flex w-full shrink-0 flex-col gap-3 sm:flex-row lg:w-auto lg:flex-col">
					<a
						class="inline-flex items-center justify-center gap-2.5 rounded-pill bg-accent px-8 py-4 font-label-md text-label-md font-semibold text-white shadow-level-2 transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent-hover hover:shadow-cta-hover"
						href="https://wa.me/51999999999?text=Hola%20Montara,%20quisiera%20asesoría%20sobre%20el%20catálogo%20de%20proyectos"
						rel="noopener noreferrer"
						target="_blank"
					>
						<span class="material-symbols-outlined text-[20px]">chat</span>
						<span>Hablar con un asesor en WhatsApp</span>
					</a>
					<a
						class="inline-flex items-center justify-center gap-2 rounded-pill border border-white/20 bg-white/10 px-6 py-3 font-label-md text-label-md font-semibold text-white backdrop-blur-md transition-all hover:bg-white/20"
						href="#"
					>
						<span class="material-symbols-outlined text-[18px]">calendar_today</span>
						<span>Agendar videollamada guiada</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>
